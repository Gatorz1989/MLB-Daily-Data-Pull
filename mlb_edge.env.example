# MLB Edge Report — Data Pull Config
# Copy this file to .env and fill in your keys
# Place .env in the same directory as mlb_edge_data_pull.py

# ── Required ────────────────────────────────────────────────
ODDS_API_KEY=your_odds_api_key_here

# ── Optional ────────────────────────────────────────────────
BIGBALL_API_KEY=your_bigdataball_key_here

# Odds API region: us | uk | au | eu
ODDS_REGION=us

# Bookmakers (comma-separated, DK-first priority)
ODDS_BOOKS=draftkings,fanduel,betmgm,bet365_us

# Minimum edge % to include in output (0 = include all)
EDGE_MIN_PCT=0

# Output path (default is ./mlb_edge_data.json)
# OUTPUT_PATH=/path/to/mlb_edge_data.json
